# =============================================================================
# Kirikou Media Intelligence — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — app will crash on startup if these are missing
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/kirikou

# Secret key used for signing tokens / sessions
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-secrets-module

# JWT signing key (must be different from SECRET_KEY)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-separate-key

# -----------------------------------------------------------------------------
# JWT SETTINGS — defaults are sensible for development
# -----------------------------------------------------------------------------

# Algorithm used for JWT signing
# Default: HS256
JWT_ALGORITHM=HS256

# Token expiration time in minutes
# Default: 60
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# CELERY / REDIS — async task queue settings
# -----------------------------------------------------------------------------

# Redis URL used as the Celery task broker
# Default: redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Redis URL used to store Celery task results
# Default: redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# LOGGING — control verbosity and log output
# -----------------------------------------------------------------------------

# Logging level. One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Path to the log file (directory is created automatically)
# Default: logs/kirikou.log
LOG_FILE=logs/kirikou.log

# -----------------------------------------------------------------------------
# OPTIONAL — sensible defaults are provided; override as needed
# -----------------------------------------------------------------------------

# Enable FastAPI debug mode (never use True in production)
# Default: False
DEBUG=False

# Human-readable application name (used in logs / docs)
# Default: Kirikou Media Intelligence
APP_NAME=Kirikou Media Intelligence

# How often (in seconds) to poll RSS feeds for new articles
# Default: 3600 (1 hour)
FETCH_INTERVAL=3600

# HTTP request timeout in seconds for outbound RSS / scraping requests
# Default: 10
REQUEST_TIMEOUT=10
